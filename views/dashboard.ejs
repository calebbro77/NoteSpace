<%- include("partials/header") %>
  <section class="dashboard">
    <!-- ============================================= -->
    <!-- DASHBOARD HEADER -->
    <!-- ============================================= -->
    <div class="dashboard-header">
      <div>
        <p class="eyebrow">
          YOUR WORKSPACE
        </p>
        <h1>
          Welcome back, <%= username %> 👋
        </h1>
        <p>
          Keep your thoughts organized and share ideas when you're ready.
        </p>
      </div>
      <a href="/notes/new" class="button button-primary">
        <i data-lucide="plus"></i>
        New Note
      </a>
    </div>
    <!-- ============================================= -->
    <!-- USER NOTES -->
    <!-- ============================================= -->
    <section class="notes-section">
      <h2>
        My Notes
      </h2>
      <% if (notes.length===0) { %>
        <!-- Empty state -->
        <div class="empty-notes">
          <i data-lucide="notebook"></i>
          <h3>
            No notes yet
          </h3>
          <p>
            Create your first note to get started.
          </p>
          <a href="/notes/new" class="button button-primary">
            <i data-lucide="plus"></i>
            Create a Note
          </a>
        </div>
        <% } else { %>
          <!-- Note grid -->
          <div class="notes-grid">
            <% notes.forEach((note)=> { %>
              <article class="note-card">
                <h3>
                  <%= note.title %>
                </h3>
                <p class="note-preview">
                  <%= note.preview.length> 160
                    ? note.preview.substring(0, 160) + "..."
                    : note.preview
                    %>
                </p>
                <div class="note-card-footer">
                  <small>
                    Updated
                    <%= note.updatedAt.toLocaleDateString() %>
                  </small>
                  <a href="/notes/<%= note._id %>" class="note-link">
                    Open Note
                    <i data-lucide="arrow-right"></i>
                  </a>
                </div>
              </article>
              <% }); %>
          </div>
          <% } %>
    </section>
  </section>
  <%- include("partials/footer") %>